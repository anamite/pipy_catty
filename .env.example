OPENAI_API_KEY=
SPEECHMATICS_API_KEY=

# Optional overrides
OPENAI_MODEL=gpt-4.1
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_VOICE_ID=alloy

# Wake word (openWakeWord). Built-in options: hey_jarvis, alexa, hey_mycroft,
# hey_rhasspy, timer, weather
WAKE_WORD=hey_jarvis
WAKE_THRESHOLD=0.5       # 0-1; raise to reduce false triggers
WAKE_LISTEN_SECONDS=8    # after wake, how long to wait for you to start talking
FOLLOWUP_SECONDS=3       # after the bot replies, mic stays open this long

# Lity — custom OpenAI-compatible LLM backend (turns + proactive pushes)
LITY_BASE_URL=http://localhost:8321/v1
LITY_API_KEY=            # optional; leave blank if Lity has no auth
LITY_MODEL=lity
LITY_POLL_SECONDS=4      # how often to poll /voice/pending while idle
